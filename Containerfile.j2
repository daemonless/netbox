ARG BASE_VERSION="15.1"
ARG VERSION=""
ARG UPSTREAM_URL="https://api.github.com/repos/netbox-community/netbox/releases/latest"
ARG UPSTREAM_JQ=".tag_name"

# ---------------------------------------------------------------- builder
FROM ghcr.io/daemonless/base:${BASE_VERSION} AS builder

ARG VERSION
ARG UPSTREAM_URL
ARG UPSTREAM_JQ
ARG EXTRA_PIP=""
# Pin if you like: --build-arg GRANIAN_SPEC="granian==2.x.y"
ARG GRANIAN_SPEC="granian[uvloop]"

RUN pkg update && pkg install -y \
      FreeBSD-clang FreeBSD-clang-dev FreeBSD-toolchain FreeBSD-clibs-dev FreeBSD-runtime-dev FreeBSD-audit-dev \
      FreeBSD-utilities-dev FreeBSD-libexecinfo-dev FreeBSD-openssl-dev FreeBSD-zlib-dev FreeBSD-bmake \
      python312 rust pkgconf jq \
      postgresql18-client jpeg-turbo freetype2 && \
    pkg clean -ay && rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

ENV CFLAGS="-I/usr/local/include" LDFLAGS="-L/usr/local/lib"

RUN NB_TAG=${VERSION:-$(fetch -qo - "${UPSTREAM_URL}" | jq -r "${UPSTREAM_JQ}")} && \
    fetch -qo /tmp/netbox.tar.gz \
      "https://github.com/netbox-community/netbox/archive/refs/tags/${NB_TAG}.tar.gz" && \
    mkdir -p /app && \
    tar xzf /tmp/netbox.tar.gz -C /app --strip-components=1 && \
    rm /tmp/netbox.tar.gz && \
    echo "${NB_TAG#v}" > /app/version

# NetBox requirements + Granian (compiled from sdist via maturin/cargo)
RUN python3.12 -m venv /app/venv && \
    /app/venv/bin/pip install --no-cache-dir --upgrade pip wheel setuptools && \
    /app/venv/bin/pip install --no-cache-dir -r /app/requirements.txt && \
    if [ -n "${EXTRA_PIP}" ]; then /app/venv/bin/pip install --no-cache-dir ${EXTRA_PIP}; fi

RUN /app/venv/bin/pip install --no-cache-dir "${GRANIAN_SPEC}"

COPY root/app/netbox/netbox/configuration.py /app/netbox/netbox/configuration.py

RUN cd /app && /app/venv/bin/zensical build && \
    rm -fr /app/.cache && \
    NETBOX_SECRET_KEY="$(python3.12 -c 'import secrets;print(secrets.token_urlsafe(64))')" \
    NETBOX_API_TOKEN_PEPPER="$(python3.12 -c 'import secrets;print(secrets.token_urlsafe(64))')" \
      /app/venv/bin/python ./netbox/manage.py collectstatic --no-input

RUN /app/venv/bin/python -m compileall -q -j 0 \
      --invalidation-mode checked-hash /app/netbox

# ---------------------------------------------------------------- runtime
FROM ghcr.io/daemonless/base-rcd:${BASE_VERSION}

ARG VERSION
ARG UPSTREAM_URL
ARG UPSTREAM_JQ
ARG PACKAGES="python312 postgresql18-client jpeg-turbo freetype2"

LABEL org.opencontainers.image.title="{{ title }}" \
      org.opencontainers.image.description="{{ description }}" \
      org.opencontainers.image.source="{{ repo_url }}" \
      org.opencontainers.image.url="{{ web_url }}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.daemonless.category="{{ category }}" \
      io.daemonless.port="{{ ports[0].port }}" \
      io.daemonless.volumes="{{ volumes | map(attribute='path') | join(',') }}" \
      io.daemonless.packages="${PACKAGES}" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}"

ENV HOME=/config

RUN pkg update && pkg install -y ${PACKAGES} && \
    pkg clean -ay && rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

COPY --from=builder /app /app
COPY root/ /

RUN mkdir -p /config && \
    chown -R bsd:bsd /config /app && \
    chmod +x /daemonless/libexec/* /daemonless/init.d/* /healthz

# --- Expose (Injected by Generator) ---
{%- if ports %}
EXPOSE {{ ports | map(attribute='target') | join(' ') }}
{%- endif %}

# --- Volumes (Injected by Generator) ---
{%- if volumes %}
VOLUME {{ volumes | map(attribute='path') | join(' ') }}
{%- endif %}
